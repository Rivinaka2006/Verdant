<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- State 1: When the box is FOCUSED (User is typing here) -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="#1A185F1A" /> <!-- Slight Green Tint -->
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/app_green"/>
        </shape>
    </item>

    <!-- State 2: Default (Not clicked) -->
    <item>
        <shape>
            <solid android:color="@color/input_field_bg" /> <!-- Your Dark Grey -->
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#333333"/>
        </shape>
    </item>

</selector>